# The list starts empty as required, growing as the user adds pets
pets = [] 

def display_menu():
    """Displays the menu, prompts the user for a choice, and returns it."""
    print("\n=== Pet Adoption Records ===")
    print("1. Add a pet")
    print("2. View all pets")
    print("3. Count available vs adopted")
    print("4. Find a pet by name")
    print("5. Remove a pet (Bonus)")
    print("6. Exit")
    choice = input("Choose an option (1-6): ").strip()
    return choice

def add_pet(pet_list):
    """Asks for name, animal type, and status — builds the string, adds to the list."""
    print("\n--- Add a New Pet ---")
    name = input("Enter pet name: ").strip()
    animal_type = input("Enter animal type (e.g., Dog, Cat): ").strip()
    
    # Validation loop for adoption status
    while True:
        status = input("Enter status (Available/Adopted): ").strip().capitalize()
        if status in ["Available", "Adopted"]:
            break
        print("Invalid status! Please enter 'Available' or 'Adopted'.")
    
    # Format: "Buddy - Dog - Available"
    pet_record = f"{name} - {animal_type} - {status}"
    pet_list.append(pet_record)
    print(f"Success! Added: {pet_record}")

def view_pets(pet_list):
   
    print("\n--- All Pet Records ---")
    if not pet_list:
        print("No pet records available yet.")
        return
        
    for index, pet in enumerate(pet_list, 1):
        print(f"{index}. {pet}")

def count_available_adopted(pet_list):
   
    print("\n--- Adoption Status Counts ---")
    if not pet_list:
        print("No records available to count. Available: 0, Adopted: 0")
        return
        
    available_count = 0
    adopted_count = 0
    
    for pet in pet_list:
        # Check if "Available" or "Adopted" is in the stored string
        if "Available" in pet:
            available_count += 1
        elif "Adopted" in pet:
            adopted_count += 1
            
    print(f"Available Pets: {available_count}")
    print(f"Adopted Pets:   {adopted_count}")

def find_pet(pet_list):
  
    print("\n--- Find a Pet ---")
    if not pet_list:
        print("No records available to search.")
        return
        
    search_name = input("Enter the pet name to search for: ").strip().lower()
    found = False
    
    for pet in pet_list:
        # Split the string to isolate the pet's name
        parts = pet.split(" - ")
        pet_name = parts[0]
        
        if pet_name.lower() == search_name:
            print(f"Found match: {pet}")
            found = True
            
    if not found:
        print(f"Pet named '{search_name.capitalize()}' was not found.")

